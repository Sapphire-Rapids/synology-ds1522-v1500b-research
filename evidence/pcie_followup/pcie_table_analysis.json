{
  "model_under_investigation": "DS1522+",
  "date": "2026-10-28",
  "question": "Why can an R1600 to V1500B replacement prevent SATA-controller discovery and network startup?",
  "judgment": {
    "best_supported_mechanism": "A CPU-dependent silicon classification selects a different OEM DXIO topology. The alternative DS1522 table lacks the PCIe roots used by the onboard NIC switch and JMB585, and assigns their logical lanes to Ethernet engines instead.",
    "confidence": "Strong static mechanism with corroborating R1600 topology and historical JMB585 error; not yet an observed V1500B reproduction.",
    "root_cause_proven": false,
    "important_refinement": "This is more specific than a simple PCI function renumbering: the alternative table does not enable the required roots at all.",
    "cpu_name_blacklist": "No such check is demonstrated by this chain; a CPU name/power branch can coexist with a board topology that is unsuitable for another silicon class."
  },
  "observations": [
    {
      "id": "PCIE-001",
      "claim": "SynoServiceDxe reads an 8-bit value at ECAM base 0xF8000000 + 0xD019, the secondary-bus register of 00:01.5. Historical log reports FF at this point.",
      "module": "SynoServiceDxe.efi",
      "addresses": [
        "0x40c",
        "0x6ec",
        "0xa20"
      ],
      "constant_data_address": "0x1ce0",
      "evidence_files": [
        "../synoservice_jmb585_disassembly.txt",
        "../historical_bios_logs.json"
      ],
      "limit": "One byte does not prove the root port was absent; FF is consistent with an unavailable/uninitialized port but a full failed-boot config dump is unavailable."
    },
    {
      "id": "PCIE-002",
      "claim": "Current R1600 has 00:01.5 secondary bus 09 and 09:00.0 vendor 197b/device 0585. The four onboard Realtek NICs are below a switch on 00:01.4.",
      "evidence_file": "current_r1600_topology.json"
    },
    {
      "id": "PCIE-003",
      "claim": "The OEM module contains two $A26 topology tables. Their masks distinguish platform ID0 from ID8; the actual raw entries are retained below.",
      "table_offsets": [
        "0x23a8",
        "0x3d30"
      ],
      "evidence": "tables"
    },
    {
      "id": "PCIE-004",
      "claim": "CPM looks up tables by signature and accepts a nonzero header+8 platform mask only when it intersects 1 << platform_id.",
      "module": "AmdCpmInitPeim_D919136E_early.efi",
      "function": "0x9b47be0",
      "evidence_file": "cpm_selection_pseudocode.json"
    },
    {
      "id": "PCIE-005",
      "claim": "For CPUID matching 0x00810F00 under mask0x0FFF0F00, CPM uses PCD0x4F0C4 high bits31:30 to choose class11 or class12. Values2/3 override the signature to0x00820F00. OEM $A01 maps the zero-board-value rows to platform0 or8.",
      "module": "AmdCpmInitPeim_D919136E_early.efi",
      "functions": [
        "0x9b4952b",
        "0x9b496d1",
        "0x9b478b7"
      ],
      "classification_record_offsets": [
        "0x40b0",
        "0x4118"
      ],
      "evidence_file": "cpm_selection_pseudocode.json"
    },
    {
      "id": "PCIE-006",
      "claim": "AmdNbioEarlyPhaseRVPei sends SMU message0x51 and stores returned argument0 into PCD0x4F0C4.",
      "module": "AmdNbioEarlyPhaseRVPei_52DFCF2E_early.efi",
      "message_push_address": "0x9b6aac2",
      "pcd_write_address": "0x9b6ab0d",
      "evidence_files": [
        "smu_silicon_class_pseudocode.json",
        "nbio_early_phase_disassembly.txt"
      ],
      "limit": "The SMU service was not invoked on hardware. Exact V1500B and R1600 replies have not been captured."
    },
    {
      "id": "PCIE-007",
      "claim": "AmdCpmPcieInitPeim requests $A26 through the same mask-aware lookup, walks 0x194-byte descriptors, checks engine1 plus port-present, and publishes the selected table+0x14 as the DXIO descriptor pointer.",
      "module": "AmdCpmPcieInitPeim_DE3D7A9C_early.efi",
      "function": "0x9b4d693",
      "addresses": [
        "0x9b4d6f2",
        "0x9b4da7b",
        "0x9b4da84",
        "0x9b4df05",
        "0x9b4df20"
      ],
      "evidence_files": [
        "pcie_dispatch_pseudocode.json",
        "pcie_init_pei_disassembly.txt"
      ]
    },
    {
      "id": "PCIE-008",
      "claim": "The DS1525 reference firmware has a tailored platform0 table with PCIe01.1 through01.6. Its opposite branch has the two-PCIe/Ethernet-engine layout. This is comparison evidence, not a drop-in firmware recommendation.",
      "evidence": "tables"
    },
    {
      "id": "PCIE-009",
      "claim": "Synology kernel matches fixed PCI paths to disk slots. A mismatch returns slot0 after index conversion and HddPowerOn exits without switching the disk GPIO on; syno_hddmon also skips unmatched ATA ports.",
      "evidence_file": "../os_followup/evidence.json",
      "limit": "Explains the first three internal bays when their JMB585 path is unavailable/mismatched. All installed disks were in that group in preserved successful boots, but occupancy at the failed attempt was not independently recorded."
    }
  ],
